type Player{
    id: ID!
    name: String
    team: Team
    city: String
    position: Position
}
enum Team{
    CSK
    MI
    RCB
    DC
    GT
}

enum Position{
    BATSMAN
    BOWLER
    WICKET_KEEPER
    ALL_ROUNDER
    CAPTAIN
}

type Query{
    findAll: [Player]
    findById(id: ID!): Player
    findByTeam(team: Team!): [Player]
    findByPosition(position: Position!): [Player]
}

type Mutation{
    createPlayer(name: String!, team: Team!, city: String!, position: Position!): Player
}